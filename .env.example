# Variáveis de ambiente do Dashboard de Férias
# Copie para .env e ajuste os valores (o .env não é versionado).

# String de conexão do MongoDB (Atlas ou local)
MONGODB_URI=mongodb://127.0.0.1:27017/holiday_dashboard

# Coordenador criado/promovido no primeiro acesso da API
ADMIN_EMAIL=admin@tdztrading.com.br
ALLOWED_EMAIL_DOMAIN=tdztrading.com.br

# Login com Google (Workspace). Sem estas variaveis o botao nao aparece.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_WORKSPACE_DOMAIN=tdztrading.com.br
ADMIN_PASSWORD=troque-esta-senha

# URL pública do app (usada no link de redefinição de senha)
APP_URL=http://localhost:20421

# Origens liberadas no CORS (separadas por virgula). Padrao: APP_URL + localhost.
# Use * apenas em desenvolvimento.
# CORS_ORIGINS=http://localhost:20421,https://exemplo.com

# Envio de e-mail (opcional). Sem SMTP o link de redefinição é só logado.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Popula o conjunto de demonstração no primeiro acesso
SEED_DEMO_DATA=false
# Segundo opt-in exigido para o seed de demonstração rodar (nunca em produção)
ALLOW_DEMO_SEED=false

# Frontend
PORT=20421
BASE_PATH=/
# Endereço da API usado pelo proxy do Vite durante o desenvolvimento
API_PROXY_TARGET=http://localhost:8080
