{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.mjs",
    "dev": "pnpm --filter @workspace/vacation-dashboard run dev",
    "preview": "pnpm --filter @workspace/vacation-dashboard run serve",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:libs": "tsc --build",
    "typecheck:tests": "tsc -p artifacts/api-server/tests/tsconfig.json --noEmit",
    "typecheck": "pnpm run typecheck:libs && pnpm run typecheck:tests && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1",
    "vitest": "^5.0.5"
  }
}
